# CoolNet AI Configuration Template
# Copy this file to .env and configure your local or deployment environment variables.
# NEVER commit real credentials or private keys to source control.

# =========================================================
# 1. LLM Explanation Service Configuration
# =========================================================
# API Key for LLM provider (OpenAI, Groq, OpenRouter, Azure, Ollama, etc.)
LLM_API_KEY=your-api-key-here

# Model identifier (e.g. gpt-4o-mini, gpt-4o, llama-3.3-70b-versatile, etc.)
LLM_MODEL=gpt-4o-mini

# Base URL for the OpenAI-compatible endpoint
# For OpenAI: https://api.openai.com/v1
# For Groq: https://api.groq.com/openai/v1
# For Ollama: http://localhost:11434/v1
# For OpenRouter: https://openrouter.ai/api/v1
LLM_BASE_URL=https://api.openai.com/v1

# Request timeout in seconds
LLM_TIMEOUT=30.0

# Temperature (low temperature ensures deterministic, factual explanations)
LLM_TEMPERATURE=0.1

# Max retries on rate limits or transient errors
LLM_MAX_RETRIES=3

# =========================================================
# 2. Real ML Backend API Configuration
# =========================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=*

# =========================================================
# 3. Supabase / Persistence Configuration (Optional)
# =========================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client
